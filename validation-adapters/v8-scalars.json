{
  "name": "v8",
  "buildCommand": ["lake", "lean", "FirValidationWasm.lean"],
  "buildReplayCommand": ["lake", "env", "lean", "FirValidationWasm.lean"],
  "buildAttempts": 2,
  "buildFileAccessRecorder": {
    "kind": "file-access-recorder",
    "name": "strace",
    "command": "strace"
  },
  "buildInputReplay": {
    "kind": "build-input-replay-isolator",
    "name": "bwrap",
    "command": "bwrap"
  },
  "runCommand": [
    "node",
    "scripts/run_validation_v8.mjs",
    "scripts/wasm_semantic_host.mjs"
  ],
  "resultDomain": "selected",
  "timeoutSeconds": 120,
  "productManifest": "products.json",
  "buildInputManifest": "build-inputs.json",
  "buildTools": [
    {
      "kind": "build-driver",
      "name": "FirValidationWasm.lean",
      "path": "../FirValidationWasm.lean"
    },
    {
      "kind": "build-launcher",
      "name": "lake",
      "command": "lake",
      "resolveCommand": ["lake", "env", "which", "lake"]
    }
  ],
  "tools": [
    {
      "kind": "engine",
      "name": "node",
      "command": "node"
    },
    {
      "kind": "runner",
      "name": "scripts/run_validation_v8.mjs",
      "path": "../scripts/run_validation_v8.mjs"
    },
    {
      "kind": "runtime",
      "name": "scripts/wasm_semantic_host.mjs",
      "path": "../scripts/wasm_semantic_host.mjs"
    }
  ]
}
