{
  "name": "v8",
  "buildCommand": ["lake", "lean", "FirValidationWasm.lean"],
  "runCommand": ["node", "scripts/run_validation_v8.mjs"],
  "resultDomain": "selected",
  "timeoutSeconds": 120,
  "products": [
    {
      "kind": "wasm-manifest",
      "path": "modules/uint8-max.wasm.json"
    },
    {
      "kind": "wasm-manifest",
      "path": "modules/uint16-max.wasm.json"
    },
    {
      "kind": "wasm-manifest",
      "path": "modules/uint32-max.wasm.json"
    },
    {
      "kind": "wasm-manifest",
      "path": "modules/uint64-max.wasm.json"
    },
    {
      "kind": "wasm-manifest",
      "path": "modules/usize-max.wasm.json"
    },
    {
      "kind": "wasm-module",
      "path": "modules/uint8-max.wasm"
    },
    {
      "kind": "wasm-module",
      "path": "modules/uint16-max.wasm"
    },
    {
      "kind": "wasm-module",
      "path": "modules/uint32-max.wasm"
    },
    {
      "kind": "wasm-module",
      "path": "modules/uint64-max.wasm"
    },
    {
      "kind": "wasm-module",
      "path": "modules/usize-max.wasm"
    }
  ],
  "tools": [
    {
      "kind": "engine",
      "name": "node",
      "command": "node"
    },
    {
      "kind": "runner",
      "name": "scripts/run_validation_v8.mjs",
      "path": "../scripts/run_validation_v8.mjs"
    }
  ]
}
