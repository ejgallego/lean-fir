{
  "version": 3,
  "name": "lean-wasm-semantic",
  "contract": {
    "format": "wasm",
    "target": "wasm32",
    "runtimeFlavor": "fir-semantic-runtime-v1",
    "abi": "fir-semantic-abi-v1"
  },
  "buildCommand": ["lake", "--no-cache", "lean", "FirValidationWasm.lean"],
  "buildReplayCommand": ["lake", "--no-cache", "env", "lean", "FirValidationWasm.lean"],
  "buildAttempts": 2,
  "buildFileAccessRecorder": {
    "kind": "file-access-recorder",
    "name": "strace",
    "command": "strace"
  },
  "buildInputReplay": {
    "kind": "build-input-replay-isolator",
    "name": "bwrap",
    "command": "bwrap"
  },
  "bundleManifest": "products.json",
  "buildInputManifest": "build-inputs.json",
  "buildTools": [
    {
      "kind": "build-driver",
      "name": "FirValidationWasm.lean",
      "path": "../FirValidationWasm.lean"
    },
    {
      "kind": "build-launcher",
      "name": "lake",
      "command": "lake",
      "resolveCommand": ["lake", "env", "which", "lake"]
    }
  ],
  "timeoutSeconds": 120
}
