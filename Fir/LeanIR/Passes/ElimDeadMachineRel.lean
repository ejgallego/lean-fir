        .ok nextRuntime) :
    Σ location,
      DeletedUSizeSetLocalReadyAt state object index field location :=
  Classical.choice
    (DeletedUSizeSetLocalReadyAt.of_effect_nonempty
      objectRead fieldRead effect)

