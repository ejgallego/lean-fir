                            cases location? <;>
                              simp [reuse, allocCtor, mismatch, Bind.bind,
                                Except.bind] at sourceReuseEq
                        | object ref =>
                            simp [reuse] at sourceReuseEq
                        | usize value =>
                            simp [reuse] at sourceReuseEq
                        | scalar value =>
                            simp [reuse] at sourceReuseEq
                        | erased =>
                            simp [reuse] at sourceReuseEq
