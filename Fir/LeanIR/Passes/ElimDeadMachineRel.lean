          | tagged payload =>
              simp [coreStep, invokeClosure, fail] at sourceTransition'
          | usize value =>
              simp [coreStep, invokeClosure, fail] at sourceTransition'
          | scalar value =>
              simp [coreStep, invokeClosure, fail] at sourceTransition'
          | erased =>
              simp [coreStep, invokeClosure, fail] at sourceTransition'
