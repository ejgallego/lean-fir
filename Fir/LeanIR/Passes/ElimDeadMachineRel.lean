    sourceState with
    control := .invokeValue (.object (.heap sourceLocation)) sourceArguments }
  let targetInvoke := {
    targetState with
    control := .invokeValue (.object (.heap targetLocation)) targetArguments }
  have combinedArguments : ArrayRel (ValueRel rho)
