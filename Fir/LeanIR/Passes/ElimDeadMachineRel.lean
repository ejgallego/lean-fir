            intro value member
            simp only [List.mem_cons] at member ⊢
            rcases member with same | frameRoot
            · subst value
              exact List.mem_cons_self
            · exact List.mem_cons_of_mem _
                (List.mem_append_right _ frameRoot)
          have nextRuntime := published.restrictExtra
