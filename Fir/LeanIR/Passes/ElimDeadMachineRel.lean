      sourceAfter) :
    ∃ larger targetAfter,
      RenamingExtends rho larger ∧
      NonLockstep.Reaches externals
        { targetState with
          control := .code (.let {
            fvarId, binderName, type, value := .lit literalValue
          } targetContinuation) }
        targetAfter ∧
      ReachableMachineRelated fuel larger sourceAfter targetAfter := by
