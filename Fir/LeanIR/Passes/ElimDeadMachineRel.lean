    targetState with
    control := .code (.let {
      fvarId, binderName, type, value := .lit literalValue
    } targetContinuation) }
  let sourceExpected := {
    sourceState with
    runtime := sourceRuntime
    env := bind sourceState.env fvarId sourceValue
    control := .code sourceContinuation }
