          have sourceSame : { source with
              control := .invokeValue sourceFunction sourceArguments } =
                source := by
            cases source
            simp_all
          have targetSame : { target with
              control := .invokeValue targetFunction targetArguments } =
                target := by
            cases target
            simp_all
