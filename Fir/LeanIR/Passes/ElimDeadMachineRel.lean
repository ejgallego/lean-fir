        evalArg sourceState.env field = fieldResult
      cases fieldResult with
      | error fault =>
          have done : coreStep sourceCurrent =
              .done (observe sourceCurrent (.fault fault)) := by
            simp [sourceCurrent, withCodeControl, coreStep, objectRead,
