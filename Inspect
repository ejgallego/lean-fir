import Lean.Compiler.LCNF
import Lean.Elab.Command
import Fir.LeanIR
import Fir.LeanIR.LegacyExamples

open Lean
open Lean.Elab.Command
open Lean.Compiler
open Fir.LeanIR.Legacy

namespace Fir.Inspect

syntax (name := firInspectLCNF) "#fir_inspect_lcnf " ident* : command

def supportedText (b : Bool) : String :=
  if b then "yes" else "no"

def resultText : Except EvalError Value -> String
  | .ok _ => "ok"
  | .error (.arityMismatch expected actual) => s!"arity-mismatch({expected},{actual})"
  | .error .unsupported => "unsupported"
  | .error .unreachable => "unreachable"
  | .error (.unknownVar _) => "unknown-var"

def unsupportedLetValue? : LCNF.LetValue .impure -> Option String
  | .lit _ => none
  | .erased => none
  | .proj .. => some "proj"
  | .const .. => some "const"
  | .fvar .. => some "fvar"
  | .ctor .. => some "ctor"
  | .oproj .. => some "oproj"
  | .uproj .. => some "uproj"
  | .sproj .. => some "sproj"
  | .fap .. => some "fap"
  | .pap .. => some "pap"
  | .reset .. => some "reset"
  | .reuse .. => some "reuse"
  | .box .. => some "box"
  | .unbox .. => some "unbox"
  | .isShared .. => some "isShared"

partial def firstUnsupportedCode? : LCNF.Code .impure -> Option String
  | .let decl k =>
      match unsupportedLetValue? decl.value with
      | some reason => some reason
      | none => firstUnsupportedCode? k
  | .return _ => none
  | .unreach _ => none
  | .fun .. => some "fun"
  | .jp .. => some "jp"
  | .jmp .. => some "jmp"
  | .cases .. => some "cases"
  | .oset .. => some "oset"
  | .uset .. => some "uset"
  | .sset .. => some "sset"
  | .setTag .. => some "setTag"
  | .inc _ _ _ _ k _ => firstUnsupportedCode? k
  | .dec .. => some "dec"
  | .del .. => some "del"

#guard firstUnsupportedCode? Fir.LeanIR.LegacyExamples.letLitReturn == none
#guard firstUnsupportedCode? Fir.LeanIR.LegacyExamples.incLetReturn == none
#guard firstUnsupportedCode? Fir.LeanIR.LegacyExamples.unsupportedSetTag == some "setTag"

def borrowedParamCount (params : Array (LCNF.Param .impure)) : Nat :=
  params.foldl (init := 0) fun count param =>
    if param.borrow then count + 1 else count

def firstUnsupportedDecl? (decl : LCNF.Decl .impure) : Option String :=
  match decl.value with
  | .code code => firstUnsupportedCode? code
  | .extern _ => some "extern"

def legacySupported? (decl : LCNF.Decl .impure) : Bool :=
  match decl.value with
  | .code code => supportedCode? code
  | .extern _ => false

def legacyCallReady? (decl : LCNF.Decl .impure) : Bool :=
  legacySupported? decl

def legacySampleArgs? : Name -> Option (List Value)
  | `Fir.Inspect.CompilerSamples.litNat => some []
  | `Fir.Inspect.CompilerSamples.idNat => some [.lit (.nat 42)]
  | _ => none

def legacyEvalText (decl : LCNF.Decl .impure) : String :=
  match legacySampleArgs? decl.name with
  | none => "skipped"
  | some args => resultText (evalDecl args decl)

def machineResultText : Fir.LeanIR.Impure.RunResult → String
  | .done observation =>
      match observation.outcome with
      | .returned _ => "ok"
      | .fault fault => s!"fault({repr fault})"
  | .outOfFuel _ => "out-of-fuel"

def pairRuntimeAndValue : Fir.LeanIR.Impure.RuntimeState × Fir.LeanIR.Impure.Value :=
  let info : LCNF.CtorInfo :=
    { name := `Prod.mk, cidx := 0, size := 2, usize := 0, ssize := 0 }
  match Fir.LeanIR.Impure.allocCtor {} info #[
      .object (.tagged 41), .object (.tagged 42)] with
  | .ok result => result
  | .error _ => ({}, .erased)

def machineSample? : Name →
    Option (Fir.LeanIR.Impure.RuntimeState × Array Fir.LeanIR.Impure.Value)
  | `Fir.Inspect.CompilerSamples.litNat => some ({}, #[])
  | `Fir.Inspect.CompilerSamples.idNat => some ({}, #[.object (.tagged 42)])
  | `Fir.Inspect.CompilerSamples.branchNat => some ({}, #[.object (.tagged 1)])
  | `Fir.Inspect.CompilerSamples.pairFirst => some (pairRuntimeAndValue.1, #[pairRuntimeAndValue.2])
  | _ => none

def machineEvalText (decl : LCNF.Decl .impure) : String :=
  match machineSample? decl.name with
  | none => "skipped"
  | some (runtime, args) =>
      machineResultText <| Fir.LeanIR.Impure.runProgram 100
        Fir.LeanIR.Impure.rejectExternals { decls := #[decl] } decl.name args runtime

def reasonText : Option String -> String
  | none => "-"
  | some reason => reason

def coverageLine (decl : LCNF.Decl .impure) : String :=
  s!"{decl.name}: params={decl.params.size}, borrowed={borrowedParamCount decl.params}, " ++
    s!"legacy-supported={supportedText (legacySupported? decl)}, " ++
    s!"legacy-call-ready={supportedText (legacyCallReady? decl)}, " ++
    s!"legacy-eval={legacyEvalText decl}, " ++
    s!"machine-eval={machineEvalText decl}, " ++
    s!"legacy-first-unsupported={reasonText (firstUnsupportedDecl? decl)}"

structure GeneratedLCNFReport where
  formatted : String
  coverage : String
  checkpoint : String

def checkpointDeclSize? (decls : Array (LCNF.Decl .impure)) (declName : Name) : Option Nat :=
  (decls.find? (·.name == declName)).map (·.size)

def checkpointText (declName : Name) (checkpoint : Option Fir.LeanIR.ImpurePassCheckpoint) : String :=
  match checkpoint with
  | none => s!"{declName}: simpCase checkpoint missing"
  | some checkpoint =>
      match checkpointDeclSize? checkpoint.before declName,
        checkpointDeclSize? checkpoint.after declName with
      | some beforeSize, some afterSize =>
          s!"{declName}: pass={checkpoint.key.name}, occurrence={checkpoint.key.occurrence}, " ++
            s!"before-size={beforeSize}, after-size={afterSize}"
      | _, _ => s!"{declName}: simpCase checkpoint did not contain the declaration"

def compileAndReportImpureDecl (declName : Name) : CoreM GeneratedLCNFReport := do
  Lean.Compiler.LCNF.main #[declName] (← getOptions)
  let checkpoint ← Fir.LeanIR.findLatestImpurePassCheckpoint?
    (Fir.LeanIR.pass .impure `simpCase) declName
  let some decl ← Lean.Compiler.LCNF.getLocalImpureDecl? declName
    | return {
        formatted := s!"{declName}: no local impure LCNF declaration",
        coverage := s!"{declName}: legacy-supported=no, legacy-call-ready=no, " ++
          "legacy-eval=skipped, machine-eval=skipped, " ++
          "legacy-first-unsupported=no-local-impure-decl",
        checkpoint := checkpointText declName checkpoint }
  return {
    formatted := toString (← Lean.Compiler.LCNF.ppDecl' decl .impure),
    coverage := coverageLine decl,
    checkpoint := checkpointText declName checkpoint }

@[command_elab firInspectLCNF]
def elabFirInspectLCNF : CommandElab := fun stx => do
  match stx with
  | `(#fir_inspect_lcnf $ids:ident*) =>
      liftCoreM Fir.LeanIR.installSimpCaseCapture
      let reports ← ids.mapM fun id => do
        let declName ← resolveGlobalConstNoOverload id
        liftCoreM <| compileAndReportImpureDecl declName
      liftIO <| IO.println ""
      liftIO <| IO.println "Generated LCNF"
      reports.forM fun report => do
        liftIO <| IO.println report.formatted
        liftIO <| IO.println ""
      liftIO <| IO.println "Generated LCNF Coverage"
      reports.forM fun report =>
        liftIO <| IO.println report.coverage
      liftIO <| IO.println ""
      liftIO <| IO.println "Compiler Checkpoints"
      reports.forM fun report =>
        liftIO <| IO.println report.checkpoint
  | _ => throwError "unsupported #fir_inspect_lcnf syntax"

namespace CompilerSamples

def litNat : Nat :=
  42

def idNat (x : Nat) : Nat :=
  x

def branchNat (b : Bool) : Nat :=
  if b then 1 else 0

def pairFirst (p : Nat × Nat) : Nat :=
  p.1

end CompilerSamples

structure InspectEntry where
  name : String
  supported : Bool
  result : Except EvalError Value

def InspectEntry.line (entry : InspectEntry) : String :=
  s!"{entry.name}: supported={supportedText entry.supported}, eval={resultText entry.result}"

def entries : List InspectEntry :=
  [ { name := "letLitReturn",
      supported := supportedCode? Fir.LeanIR.LegacyExamples.letLitReturn,
      result := eval ({} : Env) Fir.LeanIR.LegacyExamples.letLitReturn },
    { name := "nestedLetReturnFirst",
      supported := supportedCode? Fir.LeanIR.LegacyExamples.nestedLetReturnFirst,
      result := eval ({} : Env) Fir.LeanIR.LegacyExamples.nestedLetReturnFirst },
    { name := "shadowingReturnLatest",
      supported := supportedCode? Fir.LeanIR.LegacyExamples.shadowingReturnLatest,
      result := eval ({} : Env) Fir.LeanIR.LegacyExamples.shadowingReturnLatest },
    { name := "erasedLetReturn",
      supported := supportedCode? Fir.LeanIR.LegacyExamples.erasedLetReturn,
      result := eval ({} : Env) Fir.LeanIR.LegacyExamples.erasedLetReturn },
    { name := "incLetReturn",
      supported := supportedCode? Fir.LeanIR.LegacyExamples.incLetReturn,
      result := eval ({} : Env) Fir.LeanIR.LegacyExamples.incLetReturn },
    { name := "unsupportedSetTag",
      supported := supportedCode? Fir.LeanIR.LegacyExamples.unsupportedSetTag,
      result := eval ({} : Env) Fir.LeanIR.LegacyExamples.unsupportedSetTag } ]

def main : IO Unit := do
  IO.println "FIR legacy baseline"
  for entry in entries do
    IO.println entry.line

#eval main

#fir_inspect_lcnf CompilerSamples.litNat CompilerSamples.idNat
  CompilerSamples.branchNat CompilerSamples.pairFirst

end Fir.Inspect
